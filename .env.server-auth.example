# ============================================================================
# TitanFit / GymOS — Server-Side Authentication & Zero-Client-Leak Environment
# Template: .env.server-auth.example
# Target Migration: PR 1 (Branch: security/server-auth)
# DO NOT COMMIT REAL PRODUCTION PASSWORDS OR SECRETS!
# ============================================================================

# ----------------------------------------------------------------------------
# 1. CORE NETWORK & APPLICATION URLS
# ----------------------------------------------------------------------------
NODE_ENV=production
NEXT_PUBLIC_APP_NAME="TitanFit"
NEXT_PUBLIC_API_URL="https://api-titanfit.up.railway.app/api/v1"
NEXT_PUBLIC_WEB_URL="https://titanfit.up.railway.app"
API_PORT=4000
API_HOST="0.0.0.0"
API_CORS_ORIGINS="https://titanfit.up.railway.app"
COOKIE_DOMAIN=".railway.app"

# ----------------------------------------------------------------------------
# 2. POSTGRESQL MULTI-TENANT DATABASE WITH RLS
# ----------------------------------------------------------------------------
# DATABASE_MIGRATION_URL: High-privilege role used ONLY during deployment
DATABASE_MIGRATION_URL="postgresql://gymos_owner:[REDACTED]@postgres.railway.internal:5432/railway?schema=public"

# DATABASE_URL: Runtime app role (NOSUPERUSER, NOBYPASSRLS) enforcing RLS
DATABASE_URL="postgresql://gymos_app:[REDACTED]@postgres.railway.internal:5432/railway?schema=public&connection_limit=20&pool_timeout=15"

# ----------------------------------------------------------------------------
# 3. JWT & CRYPTOGRAPHY SECRETS (Generate with: openssl rand -hex 32)
# ----------------------------------------------------------------------------
JWT_ACCESS_SECRET="[REDACTED_64_CHAR_HEX_ACCESS_TOKEN_SECRET]"
JWT_REFRESH_SECRET="[REDACTED_64_CHAR_HEX_REFRESH_TOKEN_SECRET]"
JWT_ACCESS_TTL_SECONDS=900        # 15 minutes
JWT_REFRESH_TTL_SECONDS=604800     # 7 days
COOKIE_SECRET="[REDACTED_64_CHAR_HEX_COOKIE_SIGNING_SECRET]"
CSRF_SECRET="[REDACTED_64_CHAR_HEX_CSRF_PROTECTION_SECRET]"

# AES-256-GCM Key for Health Vault and Encrypted Phone Records (32 bytes hex)
HEALTH_DATA_ENCRYPTION_KEY="[REDACTED_64_CHAR_HEX_ENCRYPTION_KEY]"

# ----------------------------------------------------------------------------
# 4. ARGON2ID PASSWORD HASHING TUNING (OWASP Standard)
# ----------------------------------------------------------------------------
ARGON2_MEMORY_COST=65536           # 64 MB
ARGON2_TIME_COST=3                # 3 iterations
ARGON2_PARALLELISM=4              # 4 threads

# ----------------------------------------------------------------------------
# 5. COMPOUND RATE LIMITING (@nestjs/throttler)
# ----------------------------------------------------------------------------
THROTTLE_GLOBAL_TTL=60            # 1 minute window
THROTTLE_GLOBAL_LIMIT=60          # 60 requests / min per IP (generous for shared Wi-Fi)
THROTTLE_TENANT_FAIL_LIMIT=10     # Max 10 failed logins per (IP, tenantId) / 15 mins
THROTTLE_PHONE_BACKOFF_BASE_MS=1000 # Progressive backoff per phone: 1s, 2s, 4s, 8s (NO hard lockout to prevent Targeted DoS)
THROTTLE_BACKOFF_FACTOR_MS=1000   # Progressive delay base per tenant

# ----------------------------------------------------------------------------
# 6. HIGH-ENTROPY JOINING CODE SPECIFICATION
# ----------------------------------------------------------------------------
JOIN_CODE_ALPHABET="0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ"
JOIN_CODE_LENGTH=10               # >= 10 chars (62^10 = 8.39e17 combinations, ~60 bits)
SINGLE_USE_TOKEN_TTL_HOURS=24     # One-time tokens expire after 24h

# ----------------------------------------------------------------------------
# 7. TELEMETRY & SECURITY MONITORING
# ----------------------------------------------------------------------------
CSP_REPORT_ONLY=true
CSP_REPORT_URI="/api/v1/telemetry/csp-report"
LOG_LEVEL="info"

# ----------------------------------------------------------------------------
# 8. E2E SEED ACCOUNT PARAMETERS (Active ONLY during CI / Staging Test Runs)
# ----------------------------------------------------------------------------
E2E_SEED_ENABLED=false
E2E_ADMIN_EMAIL="[REDACTED_TEST_OWNER_EMAIL]"
E2E_ADMIN_PASSWORD="[REDACTED_TEST_OWNER_PASSWORD]"
E2E_GYM_PIN="[REDACTED_TEST_JOIN_CODE]"
