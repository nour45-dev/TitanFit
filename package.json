{
  "name": "gymos-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "GymOS - Multi-tenant Gym Management SaaS Platform Monorepo",
  "packageManager": "pnpm@10.6.5",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "postinstall": "pnpm --filter @gymos/config build && pnpm --filter @gymos/contracts build && pnpm --filter @gymos/database build && pnpm --filter @gymos/ui build",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "test:e2e": "turbo run test:e2e",
    "secret:scan": "node infra/scripts/secret-scan.mjs",
    "db:generate": "pnpm --filter @gymos/database db:generate",
    "db:migrate:deploy": "pnpm --filter @gymos/database db:migrate:deploy",
    "db:seed": "pnpm --filter @gymos/database db:seed",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json}\""
  },
  "devDependencies": {
    "prettier": "^3.5.3",
    "turbo": "^2.4.4",
    "typescript": "^5.8.2"
  }
}
