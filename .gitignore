# ============================================================================
# GymOS Monorepo — Strict .gitignore
# NEVER commit secrets, .env files, certificates, keys, or local data volumes
# ============================================================================

# Environment & Secrets (CRITICAL)
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
secrets/
.secrets/
credentials.json
service-account*.json
*.kubeconfig

# Dependencies
node_modules/
.pnp
.pnp.js
.pnpm-store/
.pnpm-debug.log*

# Build & Framework Outputs
dist/
build/
out/
.next/
.turbo/
.swc/
.vercel/
.railway/
storybook-static/
*.tsbuildinfo

# Testing & Coverage
coverage/
.nyc_output/
playwright-report/
test-results/
blob-report/
playwright/.cache/

# Local Infrastructure & Volumes (Docker / DB / MinIO)
.docker/
docker-data/
volumes/
postgres-data/
redis-data/
minio-data/
*.db
*.sqlite
*.sqlite3
*.sql.gz
*.dump

# Logs & OS Artifacts
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.DS_Store
Thumbs.db
Desktop.ini

# IDE & Editor Temporary Files
.idea/
*.swp
*.swo
*~
