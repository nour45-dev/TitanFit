# ============================================================================
# GymOS — Environment Variables Template (.env.example)
# Copy to .env.local for local development. NEVER commit real .env files!
# On Railway, configure these variables per service in the Railway Dashboard.
# ============================================================================

# ----------------------------------------------------------------------------
# 1. PLATFORM & BRANDING (@gymos/config)
# ----------------------------------------------------------------------------
NODE_ENV=development
NEXT_PUBLIC_APP_NAME="GymOS"
NEXT_PUBLIC_DEFAULT_LOCALE="en"
NEXT_PUBLIC_SUPPORTED_LOCALES="en,ar"
NEXT_PUBLIC_DEFAULT_CURRENCY="EGP"
NEXT_PUBLIC_DEFAULT_TIMEZONE="Africa/Cairo"

# ----------------------------------------------------------------------------
# 2. NETWORK & SERVICE URLS
# On Railway: use ${{api.RAILWAY_PUBLIC_DOMAIN}} and private *.railway.internal
# ----------------------------------------------------------------------------
API_PORT=4000
API_HOST=0.0.0.0
API_CORS_ORIGINS="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"
NEXT_PUBLIC_WS_URL="ws://localhost:4000"
NEXT_PUBLIC_WEB_URL="http://localhost:3000"

# ----------------------------------------------------------------------------
# 3. POSTGRESQL DATABASE (Role-Separated for Non-Bypassable RLS)
# - DATABASE_MIGRATION_URL: Owner role (gymos_owner) used ONLY in pre-deploy
#   `prisma migrate deploy` and schema DDL.
# - DATABASE_URL: Runtime role (gymos_app) with NOSUPERUSER, NOBYPASSRLS
#   used by the NestJS API service at runtime.
# - DATABASE_WORKER_URL: Worker role (gymos_worker) with NOSUPERUSER, NOBYPASSRLS
#   used by the BullMQ background worker service.
# ----------------------------------------------------------------------------
DATABASE_MIGRATION_URL="postgresql://gymos_owner:local_owner_password_change_me@localhost:5432/gymos?schema=public"
DATABASE_URL="postgresql://gymos_app:local_app_password_change_me@localhost:5432/gymos?schema=public&connection_limit=15&pool_timeout=15"
DATABASE_WORKER_URL="postgresql://gymos_worker:local_worker_password_change_me@localhost:5432/gymos?schema=public&connection_limit=5&pool_timeout=15"

# Password variables used by the initial migration to provision runtime roles
DB_RUNTIME_APP_PASSWORD="local_app_password_change_me"
DB_RUNTIME_WORKER_PASSWORD="local_worker_password_change_me"

# ----------------------------------------------------------------------------
# 4. REDIS (Cache, BullMQ Queues, Rate Limiting, WebSocket Adapter, Redlock)
# On Railway: use REDIS_URL from Railway Redis private network
# ----------------------------------------------------------------------------
REDIS_URL="redis://localhost:6379"

# ----------------------------------------------------------------------------
# 5. AUTHENTICATION & CRYPTOGRAPHY
# Generate secrets with: openssl rand -hex 32
# ----------------------------------------------------------------------------
JWT_ACCESS_SECRET="replace_with_64_char_hex_secret_for_jwt_access_token_signing_00"
JWT_REFRESH_SECRET="replace_with_64_char_hex_secret_for_jwt_refresh_token_signing_0"
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
COOKIE_SECRET="replace_with_64_char_hex_secret_for_cookie_signing_protection_0"
HEALTH_DATA_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
QR_HMAC_MASTER_SECRET="replace_with_64_char_hex_secret_for_rotating_qr_checkin_tokens_0"

# ----------------------------------------------------------------------------
# 6. S3-COMPATIBLE OBJECT STORAGE (MinIO Locally / Cloudflare R2 in Production)
# ----------------------------------------------------------------------------
STORAGE_ENDPOINT="http://localhost:9000"
STORAGE_REGION="auto"
STORAGE_BUCKET="gymos-media"
STORAGE_BACKUP_BUCKET="gymos-backups"
STORAGE_ACCESS_KEY_ID="gymos_minio_admin"
STORAGE_SECRET_ACCESS_KEY="gymos_minio_secret_key"
STORAGE_FORCE_PATH_STYLE="true"
STORAGE_SIGNED_URL_TTL_SECONDS=900

# ----------------------------------------------------------------------------
# 7. PAYMENT GATEWAYS (Egypt & International)
# ----------------------------------------------------------------------------
PAYMOB_API_KEY="mock_paymob_api_key"
PAYMOB_HMAC_SECRET="mock_paymob_hmac_secret"
PAYMOB_INTEGRATION_ID_CARD="000000"
PAYMOB_INTEGRATION_ID_WALLET="000000"
FAWRY_MERCHANT_CODE="mock_fawry_merchant"
FAWRY_SECURITY_KEY="mock_fawry_security_key"
STRIPE_SECRET_KEY="sk_test_mock"
STRIPE_WEBHOOK_SECRET="whsec_mock"

# ----------------------------------------------------------------------------
# 8. OBSERVABILITY & ALERTS
# ----------------------------------------------------------------------------
LOG_LEVEL="info"
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
OTEL_SERVICE_NAME="gymos-api"
